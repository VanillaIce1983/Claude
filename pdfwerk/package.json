{
  "name": "pdfwerk",
  "productName": "PDFwerk",
  "version": "1.0.1",
  "private": true,
  "description": "PDF-Viewer und -Editor",
  "author": "PDFwerk",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke.mjs",
    "desktop": "node scripts/build.mjs && electron .",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "dist": "node scripts/build.mjs && electron-builder --config scripts/release-config.cjs --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --config scripts/release-config.cjs --win --x64 --arm64 --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --config scripts/release-config.cjs --mac --x64 --arm64 --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --config scripts/release-config.cjs --linux --x64 --publish never",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "app.pdfwerk.desktop",
    "productName": "PDFwerk",
    "copyright": "© PDFwerk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "!desktop/*.d.ts",
      "dist/desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDFwerk.Dokument",
          "description": "PDF-Dokument",
          "mimeType": "application/pdf",
          "role": "Editor"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PDFwerk-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFwerk",
      "uninstallDisplayName": "PDFwerk",
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ],
      "multiLanguageInstaller": false,
      "buildUniversalInstaller": false,
      "include": "scripts/installer.nsh",
      "artifactName": "PDFwerk-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF-Dokument",
          "description": "PDF-Dokument",
          "role": "Editor"
        },
        {
          "ext": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "gif"
          ],
          "name": "Bild",
          "description": "Bild",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "PDFwerk-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PDFwerk-${version}-${arch}.${ext}"
    },
    "linux": {
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF-Dokument",
          "description": "PDF-Dokument",
          "mimeType": "application/pdf"
        }
      ],
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "PDFwerk-${version}-${arch}.${ext}"
    }
  }
}
