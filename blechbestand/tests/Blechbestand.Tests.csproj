<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests der Datenlogik (ohne Oberfläche). Laufen auf Windows, Linux und macOS: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Blechbestand.Tests</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Model\*.cs" Link="Model\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
